# UBI8 ships only numactl-libs, the numactl tool comes from AlmaLinux 8 BaseOS
[AlmaLinux-8-BaseOS-numactl]
name=AlmaLinux 8 BaseOS (numactl only)
baseurl=https://repo.almalinux.org/almalinux/8/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-AlmaLinux-8
includepkgs=numactl numactl-libs
